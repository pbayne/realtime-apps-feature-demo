#!/usr/bin/env bash
# sidekick — command-line shortcuts for the deployed Sidekick app.
#
# Voice runs on Moonshine in-process by default (on the App's own CPU): no GPU endpoints, no cost when
# idle, nothing to warm. The up/down/on/off/warm commands below only matter for the optional HIGH QUALITY
# tier (A10 Parakeet + Kokoro), which you select with VOICE_BACKEND=endpoints at deploy time.
#
#   sidekick open      open the app in your browser
#   sidekick health    the app's health report (store, history, voice readiness)
#   sidekick test      end-to-end voice check (speaks into the app, saves + plays the spoken reply)
#   sidekick actions   end-to-end actions check (propose/approve under the outbox safety lock; nothing sends)
#   sidekick logs      recent app logs
#   sidekick cost      show what is currently billing (app state + which GPU endpoints exist)
#   sidekick deploy    redeploy (scripts/deploy.sh). Env knobs: VOICE_BACKEND=moonshine|endpoints,
#                      AUTO_ACCEPT_ACTIONS=true|false. e.g. AUTO_ACCEPT_ACTIONS=true sidekick deploy
#
#   --- HIGH QUALITY tier only (VOICE_BACKEND=endpoints): manage the A10 GPU endpoints ---
#   sidekick up        (re)create the GPU endpoints, start the app, warm them — for a premium demo
#   sidekick down      MONEY SAVER: stop the app and DELETE the GPU endpoints so they stop billing
#   sidekick on        GPU endpoints always-on (no cold start; they bill while on) — ~8 min
#   sidekick off       GPU endpoints back to scale-to-zero (bill only when warmed) — ~7 min
#   sidekick status    GPU endpoint readiness + scale-to-zero setting
#   sidekick warm      wake both GPU endpoints now (a few minutes before talking)
#
# on/off only flip GPU scale-to-zero (endpoints keep existing). up/down are the real lifecycle:
# down DELETES the GPU endpoints (true cost stop); up re-creates them from the register jobs. None of
# these are needed in the default Moonshine tier.
#
# Env: SIDEKICK_PROFILE (default realtime-call-sidekick), SIDEKICK_APP (default call-sidekick).
# Install: ln -s <repo>/scripts/sidekick ~/.local/bin/sidekick
set -euo pipefail

src=${BASH_SOURCE[0]}
while [[ -L "$src" ]]; do                                   # follow the ~/.local/bin symlink to the repo
  dir=$(cd "$(dirname "$src")" && pwd); src=$(readlink "$src"); [[ "$src" != /* ]] && src="$dir/$src"
done
repo=$(cd "$(dirname "$src")/.." && pwd)
py="$repo/.venv/bin/python"
profile=${SIDEKICK_PROFILE:-realtime-call-sidekick}
app=${SIDEKICK_APP:-call-sidekick}

[[ -x "$py" ]] || { echo "sidekick: no venv at $repo/.venv (uv venv --python 3.11 .venv && uv pip install -r src/app/requirements.txt)" >&2; exit 2; }

app_url() { databricks apps get "$app" --profile "$profile" -o json | "$py" -c "import sys,json; print(json.load(sys.stdin)['url'])"; }

cmd=${1:-help}
case "$cmd" in
  up)     exec "$py" "$repo/scripts/lifecycle.py" up --profile "$profile" ;;
  down)   shift; exec "$py" "$repo/scripts/lifecycle.py" down --profile "$profile" "$@" ;;
  cost)   exec "$py" "$repo/scripts/lifecycle.py" status --profile "$profile" ;;
  on)     echo "Demo mode ON: voice GPUs always-on (billing continuously until 'sidekick off'). ~8 minutes…"
          exec "$py" "$repo/scripts/demo_mode.py" on --profile "$profile" ;;
  off)    echo "Demo mode OFF: back to scale-to-zero. ~7 minutes…"
          exec "$py" "$repo/scripts/demo_mode.py" off --profile "$profile" ;;
  status) exec "$py" "$repo/scripts/demo_mode.py" status --profile "$profile" ;;
  warm)   exec "$py" "$repo/scripts/warmup_voice.py" --profile "$profile" ;;
  open)   url=$(app_url); echo "$url"; open "$url" ;;
  health) url=$(app_url)
          "$py" - "$url" "$profile" <<'PY'
import json, sys, httpx
from databricks.sdk import WorkspaceClient
url, profile = sys.argv[1], sys.argv[2]
w = WorkspaceClient(profile=profile)
d = httpx.get(url.rstrip("/") + "/api/health", headers=w.config.authenticate(), timeout=60).json()
v = d.get("voice", {})
print(json.dumps({"status": d.get("status"), "store": d.get("store"), "backbone": d.get("backbone"),
                  "history": {k: d.get("history", {}).get(k) for k in ("written", "retried", "failed", "dropped")},
                  "voice_ready": v.get("readiness", {}).get("ready"), "active_voice_sessions": v.get("active_sessions")},
                 indent=1))
PY
          ;;
  test)   out=/tmp/sidekick-test-reply.wav
          "$py" "$repo/scripts/voice_smoke.py" --profile "$profile" --out "$out" && afplay "$out" ;;
  actions) exec "$py" "$repo/scripts/actions_smoke.py" --profile "$profile" ;;
  logs)   databricks apps logs "$app" --profile "$profile" --tail-lines "${2:-80}" ;;
  deploy) shift; cd "$repo" && exec scripts/deploy.sh "$profile" "$@" ;;
  help|-h|--help) sed -n '2,30p' "$src" | sed 's/^# \{0,1\}//' ;;
  *) echo "sidekick: unknown command '$cmd' (try: sidekick help)" >&2; exit 2 ;;
esac
